# Real backend (values from `terraform output`; Amplify sets these automatically)
VITE_API_URL=https://<api-gateway-id>.execute-api.ap-southeast-1.amazonaws.com
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxx

# Set to true for local UI work without AWS: mocked API + demo users, no Cognito
VITE_USE_MOCK=false
